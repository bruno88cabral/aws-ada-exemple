# Copie para .env.local (nunca commitado) e preencha. Veja o README.
AWS_REGION=us-east-1

# Chaves do usuario IAM padaria-dev (so para o Next local; README, secao 2)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RDS: endpoint publico (README, secao 3). Os parametros no fim sao obrigatorios:
# sslmode=require puro falha contra o certificado da RDS com o driver pg instalado;
# uselibpqcompat=true faz o require significar "criptografa sem validar a CA".
DATABASE_URL=postgres://USUARIO:SENHA@HOST:5432/padaria?uselibpqcompat=true&sslmode=require

# Outputs do stack SAM (README, secao 5)
S3_BUCKET=padaria-fotos-seunome
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/pedidos

# SNS_TOPIC_ARN e SES_FROM NAO vao aqui: sao variaveis das Lambdas, definidas pelo template.yaml.
